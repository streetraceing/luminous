{
  "name": "luminous",
  "version": "2.3.1",
  "type": "module",
  "author": {
    "name": "streetraceing",
    "url": "https://github.com/streetraceing/"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "*.{js,cjs,mjs,ts}": [
      "eslint --fix"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "prettier:write": "prettier . --write",
    "prettier:check": "prettier . --check",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint:check && npm run build",
    "build": "vite build",
    "release": "npm run build && tsx vite/releaseScript.ts",
    "watch": "spicetify watch -s",
    "apply": "npm run build -- --mode sync && spicetify config current_theme Luminous && spicetify apply",
    "revert": "spicetify config current_theme marketplace && spicetify apply && npm run build -- --mode delete",
    "npm:patch": "npm version patch",
    "npm:minor": "npm version minor",
    "npm:major": "npm version major"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5"
  }
}

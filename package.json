{
  "name": "luminous",
  "version": "2.1.2",
  "type": "module",
  "author": {
    "name": "streetraceing",
    "url": "https://github.com/streetraceing/"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && tsx vite/releaseScript.ts",
    "watch": "spicetify watch -s",
    "apply": "npm run build -- --mode sync && spicetify config current_theme Luminous && spicetify apply",
    "revert": "spicetify config current_theme marketplace && spicetify apply && npm run build -- --mode delete",
    "prettier:write": "prettier . --write",
    "prepare": "husky",
    "npm:patch": "npm version patch",
    "npm:minor": "npm version minor",
    "npm:major": "npm version major",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
